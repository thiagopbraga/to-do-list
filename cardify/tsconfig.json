{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@cardify/shared": ["./libs/shared/src/index.ts"],
      "@cardify/db": ["./libs/db/src/index.ts"],
      "@cardify/ingest": ["./libs/ingest/src/index.ts"],
      "@cardify/generation": ["./libs/generation/src/index.ts"],
      "@cardify/apkg": ["./libs/apkg/src/index.ts"],
      "@cardify/queue": ["./libs/queue/src/index.ts"],
      "@cardify/storage": ["./libs/storage/src/index.ts"]
    }
  },
  "include": ["libs/*/src", "apps/api/src", "apps/worker/src", "tools/**/*.ts"]
}
