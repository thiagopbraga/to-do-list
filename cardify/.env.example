# ============================================================================
# Cardify: variáveis de ambiente para desenvolvimento local.
# Copie para o .env (cp .env.example .env). Os valores abaixo funcionam com o docker-compose.yml.
# Variável vazia (ex.: CHAVE=) equivale a variável ausente.
# ============================================================================

# --- Infra do docker-compose (só afetam as portas do host) -------------------
# Se mudar POSTGRES_PORT, ajuste também a porta em DATABASE_URL e DATABASE_URL_TEST.
POSTGRES_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Aplicação ---------------------------------------------------------------
# Ambiente: development | test | production (production exige SESSION_SECRET forte)
NODE_ENV=development
# Porta HTTP da API (apps/api)
PORT=4000
# URL pública do front (apps/web), usada em links e redirects
APP_URL=http://localhost:3000
# URL pública da API
API_URL=http://localhost:4000
# Nível de log do pino: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Banco Postgres ----------------------------------------------------------
# Banco de desenvolvimento
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cardify
# Banco de testes de integração (criado pelo postgres-init.sql do compose)
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/cardify_test

# --- Object storage (MinIO local, API compatível com S3) ---------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=cardify
# Credenciais padrão do MinIO do compose. Nunca usar em produção.
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# true para MinIO (caminho do bucket na URL, não no host)
S3_FORCE_PATH_STYLE=true

# --- LLM ---------------------------------------------------------------------
# fake: respostas simuladas, sem custo, sem rede | anthropic: chamadas reais (cobram)
LLM_PROVIDER=fake
# Obrigatória só quando LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Modelo barato, usado no estágio A (extração de fatos)
LLM_MODELO_ECONOMICO=claude-haiku-5-5
# Modelo mais forte, usado no estágio B (redação dos cards)
LLM_MODELO_FORTE=claude-sonnet-5-5
# Cotação do dólar usada para converter o custo estimado em reais
USD_BRL=5.40

# --- Pagamento ---------------------------------------------------------------
# fake: checkout simulado | asaas: sandbox do Asaas
PAGAMENTO_PROVIDER=fake
# Obrigatórias só quando PAGAMENTO_PROVIDER=asaas
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=

# --- Sessão e login Google ---------------------------------------------------
# Segredo de assinatura dos cookies. Em production, obrigatório com 32+ caracteres.
SESSION_SECRET=dev-somente-local-troque-em-producao-0123456789
# Credenciais OAuth do Google. Sem elas, o login com Google não funciona localmente.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/v1/auth/google/callback

# --- E-mail ------------------------------------------------------------------
# URL SMTP (ex.: smtp://usuario:senha@host:587). Vazio = envio desabilitado.
SMTP_URL=
EMAIL_FROM="Cardify <noreply@cardify.local>"

# --- Anti-bot (Cloudflare Turnstile) -----------------------------------------
# Valores abaixo são as chaves de teste oficiais da Cloudflare: sempre aprovam.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# --- Observabilidade (todas opcionais) ---------------------------------------
# Token do endpoint /v1/admin/metricas (header x-admin-token). Vazio = rota responde 404. Mínimo 32 caracteres.
ADMIN_TOKEN=
# Endpoint OTLP (ex.: http://localhost:4318). Vazio = OpenTelemetry desligado na API e no worker.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Gasto diário com LLM (dia UTC) acima do qual o worker loga alerta, em centavos de real
ALERTA_GASTO_DIARIO_CENTAVOS=5000

# --- Limites ----------------------------------------------------------------
# Teto diário de gasto com LLM para usuários anônimos, em centavos de real (2000 = R$ 20,00)
ANON_TETO_DIARIO_CENTAVOS=2000

# true quando a API roda atrás de proxy reverso/PaaS (IP real vem de X-Forwarded-For; usado no limite anônimo por IP)
TRUST_PROXY=false
