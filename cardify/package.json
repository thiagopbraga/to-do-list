{
  "name": "cardify",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "libs/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json && npm run -w @cardify/web build",
    "build:server": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run -w @cardify/web typecheck",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project int",
    "test:all": "vitest run",
    "db:generate": "npm run -w @cardify/db generate",
    "db:migrate": "npm run -w @cardify/db migrate",
    "dev:api": "npm run -w @cardify/api dev",
    "dev:worker": "npm run -w @cardify/worker dev",
    "dev:web": "npm run -w @cardify/web dev",
    "test:apkg": "vitest run --project int libs/apkg tools",
    "test:e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.60",
    "@swc/core": "^1.16.18",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "3.2",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "typescript-eslint": "^8.71.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "3.2"
  },
  "overrides": {
    "@nestjs/platform-fastify": {
      "fastify": "^5.12.7"
    },
    "next": {
      "postcss": "^8.5.30"
    }
  }
}
